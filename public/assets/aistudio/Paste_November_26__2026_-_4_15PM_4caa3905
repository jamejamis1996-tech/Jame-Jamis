    // ==================== CART MANAGEMENT ====================
    function addToCart(medId) {
      const med = medicines.find(m => m.id === medId);
      if (!med) return;

      const unitType = selectedUnitByMed[medId] || 'piece';
      const multiplier = unitType === 'box' ? med.boxSize : (unitType === 'blister' ? med.blisterSize : 1);

      // Calculate total pieces of this medicine already in cart
      const existingPiecesInCart = cart
        .filter(item => item.medId === medId)
        .reduce((sum, item) => {
          const mult = item.unitType === 'box' ? med.boxSize : (item.unitType === 'blister' ? med.blisterSize : 1);
          return sum + (item.qty * mult);
        }, 0);

      if (existingPiecesInCart + multiplier > med.stock) {
        showToast(`Insufficient stock for ${med.brand}! Available: ${med.stock} pcs`, 'rose');
        return;
      }

      const existingLine = cart.find(item => item.medId === medId && item.unitType === unitType);
      if (existingLine) {
        existingLine.qty += 1;
      } else {
        cart.push({ medId, unitType, qty: 1 });
      }

      renderCart();
    }

    function updateCartQty(index, delta) {
      const item = cart[index];
      const med = medicines.find(m => m.id === item.medId);
      if (!item || !med) return;

      const multiplier = item.unitType === 'box' ? med.boxSize : (item.unitType === 'blister' ? med.blisterSize : 1);

      if (delta > 0) {
        const existingPiecesInCart = cart
          .filter(c => c.medId === item.medId)
          .reduce((sum, c) => {
            const mult = c.unitType === 'box' ? med.boxSize : (c.unitType === 'blister' ? med.blisterSize : 1);
            return sum + (c.qty * mult);
          }, 0);

        if (existingPiecesInCart + multiplier > med.stock) {
          showToast(`Maximum available stock reached for ${med.brand}.`, 'amber');
          return;
        }
        item.qty += 1;
      } else {
        item.qty -= 1;
        if (item.qty <= 0) {
          cart.splice(index, 1);
        }
      }
      renderCart();
    }

    function removeCartItem(index) {
      cart.splice(index, 1);
      renderCart();
    }

    function clearCart() {
      cart = [];
      document.getElementById('cash-tendered-input').value = '';
      document.getElementById('rx-reference-input').value = '';
      renderCart();
    }

    function setDiscountType(type) {
      discountType = type;
      ['regular', 'senior', 'pwd'].forEach(t => {
        const btn = document.getElementById(`disc-${t}`);
        if (t === type) {
          btn.classList.add('bg-emerald-700', 'text-white', 'border-emerald-700');
          btn.classList.remove('bg-white', 'text-slate-700', 'border-slate-300');
        } else {
          btn.classList.remove('bg-emerald-700', 'text-white', 'border-emerald-700');
          btn.classList.add('bg-white', 'text-slate-700', 'border-slate-300');
        }
      });

      const detailsBox = document.getElementById('discount-details-fields');
      if (type === 'senior' || type === 'pwd') {
        detailsBox.classList.remove('hidden');
        detailsBox.classList.add('grid');
      } else {
        detailsBox.classList.add('hidden');
        detailsBox.classList.remove('grid');
      }
      calculateTotals();
    }

    function setPaymentMethod(method) {
      paymentMethod = method;
      ['Cash', 'GCash', 'Card'].forEach(m => {
        const btn = document.getElementById(`pay-${m}`);
        if (m === method) {
          btn.classList.add('bg-slate-800', 'text-white', 'border-slate-800');
          btn.classList.remove('bg-white', 'text-slate-700', 'border-slate-300');
        } else {
          btn.classList.remove('bg-slate-800', 'text-white', 'border-slate-800');
          btn.classList.add('bg-white', 'text-slate-700', 'border-slate-300');
        }
      });

      document.getElementById('cash-tender-box').classList.toggle('hidden', method !== 'Cash');
    }

    function calculateTotals() {
      let grossSubtotal = 0;
      cart.forEach(item => {
        const med = medicines.find(m => m.id === item.medId);
        if (med) {
          const mult = item.unitType === 'box' ? med.boxSize : (item.unitType === 'blister' ? med.blisterSize : 1);
          grossSubtotal += med.price * mult * item.qty;
        }
      });

      let vatExemptAmount = 0;
      let scPwdDiscount = 0;
      let netTotal = grossSubtotal;
      let vatableSales = grossSubtotal / 1.12;
      let vatAmount = grossSubtotal - vatableSales;

      if ((discountType === 'senior' || discountType === 'pwd') && grossSubtotal > 0) {
        // Philippine Senior Citizen / PWD Law (RA 9994 / RA 10754): Remove 12% VAT first, then apply 20% discount
        const vatExclusive = grossSubtotal / 1.12;
        vatExemptAmount = grossSubtotal - vatExclusive;
        scPwdDiscount = vatExclusive * 0.20;
        netTotal = vatExclusive - scPwdDiscount;
        vatableSales = 0;
        vatAmount = 0;
      }

      document.getElementById('summary-subtotal').textContent = formatPHP(grossSubtotal);
      
      const rowVatExempt = document.getElementById('row-vat-exempt');
      const rowDiscount = document.getElementById('row-discount');
      if (discountType === 'senior' || discountType === 'pwd') {
        rowVatExempt.classList.remove('hidden');
        rowVatExempt.classList.add('flex');
        rowDiscount.classList.remove('hidden');
        rowDiscount.classList.add('flex');
        document.getElementById('summary-vat-exempt').textContent = '-' + formatPHP(vatExemptAmount);
        document.getElementById('summary-discount').textContent = '-' + formatPHP(scPwdDiscount);
        document.getElementById('summary-vat-info').textContent = `VAT-Exempt: ${formatPHP(grossSubtotal / 1.12)}`;
      } else {
        rowVatExempt.classList.add('hidden');
        rowVatExempt.classList.remove('flex');
        rowDiscount.classList.add('hidden');
        rowDiscount.classList.remove('flex');
        document.getElementById('summary-vat-info').textContent = `${formatPHP(vatableSales)} / ${formatPHP(vatAmount)}`;
      }

      document.getElementById('summary-total').textContent = formatPHP(netTotal);
      calculateChange();

      return { grossSubtotal, vatExemptAmount, scPwdDiscount, totalDiscount: vatExemptAmount + scPwdDiscount, netTotal, vatableSales, vatAmount };
    }

    function setQuickCash(val) {
      const { netTotal } = calculateTotals();
      const input = document.getElementById('cash-tendered-input');
      if (val === 'exact') {
        input.value = netTotal.toFixed(2);
      } else {
        input.value = val;
      }
      calculateChange();
    }

    function calculateChange() {
      const { netTotal } = (() => {
        // Compute netTotal directly without recursion
        let gross = 0;
        cart.forEach(item => {
          const med = medicines.find(m => m.id === item.medId);
          if (med) {
            const mult = item.unitType === 'box' ? med.boxSize : (item.unitType === 'blister' ? med.blisterSize : 1);
            gross += med.price * mult * item.qty;
          }
        });
        if ((discountType === 'senior' || discountType === 'pwd') && gross > 0) {
          const vatEx = gross / 1.12;
          return { netTotal: vatEx - (vatEx * 0.20) };
        }
        return { netTotal: gross };
      })();

      const tendered = parseFloat(document.getElementById('cash-tendered-input').value) || 0;
      const change = Math.max(0, tendered - netTotal);
      const display = document.getElementById('cash-change-display');
      display.textContent = formatPHP(change);
      display.classList.toggle('text-emerald-700', tendered >= netTotal && netTotal > 0);
    }

    function renderCart() {
      const container = document.getElementById('cart-items-container');
      const countBadge = document.getElementById('cart-count-badge');
      const totalItems = cart.reduce((sum, i) => sum + i.qty, 0);
      countBadge.textContent = `${totalItems} item${totalItems === 1 ? '' : 's'}`;

      let hasRxItem = false;

      if (cart.length === 0) {
        container.innerHTML = `
          <div class="h-full flex flex-col items-center justify-center text-center py-8 text-slate-400">
            <svg class="w-10 h-10 mb-2 text-slate-300" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
            <p class="text-xs font-semibold">Cart is currently empty</p>
            <p class="text-[11px] mt-0.5">Select medicines from the catalog to begin checkout.</p>
          </div>`;
      } else {
        container.innerHTML = cart.map((item, idx) => {
          const med = medicines.find(m => m.id === item.medId);
          if (!med) return '';
          if (med.isRx) hasRxItem = true;

          const mult = item.unitType === 'box' ? med.boxSize : (item.unitType === 'blister' ? med.blisterSize : 1);
          const unitPrice = med.price * mult;
          const lineTotal = unitPrice * item.qty;
          const unitLabel = item.unitType === 'box' ? `Box (${med.boxSize}s)` : (item.unitType === 'blister' ? `Blister (${med.blisterSize}s)` : 'Piece');

          return `
            <div class="p-2.5 bg-slate-50 border border-slate-200 rounded-xl flex items-center justify-between gap-2">
              <div class="min-w-0 flex-1">
                <div class="flex items-center gap-1.5">
                  <span class="font-bold text-slate-900 text-xs truncate">${med.brand}</span>
                  ${med.isRx ? '<span class="text-[9px] font-extrabold bg-rose-100 text-rose-700 px-1.5 rounded">Rx</span>' : ''}
                </div>
                <div class="text-[11px] text-slate-500">${med.dosage} • ${unitLabel} @ ${formatPHP(unitPrice)}</div>
              </div>

              <div class="flex items-center gap-1.5">
                <button onclick="updateCartQty(${idx}, -1)" class="w-6 h-6 rounded-lg bg-white border border-slate-300 hover:bg-slate-100 font-bold text-slate-700 flex items-center justify-center">-</button>
                <span class="w-6 text-center text-xs font-extrabold text-slate-900">${item.qty}</span>
                <button onclick="updateCartQty(${idx}, 1)" class="w-6 h-6 rounded-lg bg-white border border-slate-300 hover:bg-slate-100 font-bold text-slate-700 flex items-center justify-center">+</button>
              </div>

              <div class="text-right min-w-[68px]">
                <div class="text-xs font-extrabold text-slate-900">${formatPHP(lineTotal)}</div>
                <button onclick="removeCartItem(${idx})" class="text-[10px] text-rose-600 hover:underline font-semibold">Remove</button>
              </div>
            </div>
          `;
        }).join('');
      }

      document.getElementById('rx-verification-box').classList.toggle('hidden', !hasRxItem);
      calculateTotals();
    }

    // ==================== CHECKOUT & RECEIPT GENERATION ====================
    function processCheckout() {
      if (cart.length === 0) {
        showToast('Cart is empty. Add medicines before checking out.', 'amber');
        return;
      }

      // Check Rx verification
      const hasRx = cart.some(item => medicines.find(m => m.id === item.medId)?.isRx);
      const rxRef = document.getElementById('rx-reference-input').value.trim();
      if (hasRx && !rxRef) {
        showToast('Please enter Doctor Name / PRC # or Rx Reference for prescription items.', 'rose');
        document.getElementById('rx-reference-input').focus();
        return;
      }

      // Check Senior / PWD fields
      const custName = document.getElementById('cust-name-input').value.trim();
      const custId = document.getElementById('cust-id-input').value.trim();
      if ((discountType === 'senior' || discountType === 'pwd') && (!custName || !custId)) {
        showToast('Customer Name and OSCA/PWD ID Number are required for 20% discount.', 'rose');
        return;
      }

      const totals = calculateTotals();
      let cashTendered = totals.netTotal;
      let changeDue = 0;

      if (paymentMethod === 'Cash') {
        cashTendered = parseFloat(document.getElementById('cash-tendered-input').value) || 0;
        if (cashTendered < totals.netTotal - 0.009) {
          showToast(`Insufficient cash tendered. Total due is ${formatPHP(totals.netTotal)}.`, 'rose');
          document.getElementById('cash-tendered-input').focus();
          return;
        }
        changeDue = Math.max(0, cashTendered - totals.netTotal);
      }

      // Deduct stock & build line items snapshot
      const lineItems = cart.map(item => {
        const med = medicines.find(m => m.id === item.medId);
        const mult = item.unitType === 'box' ? med.boxSize : (item.unitType === 'blister' ? med.blisterSize : 1);
        const totalPieces = item.qty * mult;
        med.stock -= totalPieces;

        return {
          medId: med.id,
          brand: med.brand,
          generic: med.generic,
          dosage: med.dosage,
          isRx: med.isRx,
          unitType: item.unitType,
          qty: item.qty,
          totalPieces,
          unitPrice: med.price * mult,
          lineTotal: med.price * mult * item.qty
        };
      });

      const txRecord = {
        orNumber: 'OR-' + String(100001 + transactions.length),
        timestamp: new Date().toISOString(),
        cashier: PHARMACIST_ON_DUTY,
        discountType,
        customerName: discountType === 'regular' ? 'Walk-in Customer' : custName,
        customerId: discountType === 'regular' ? '' : custId,
        rxReference: hasRx ? rxRef : '',
        paymentMethod,
        cashTendered,
        changeDue,
        ...totals,
        items: lineItems,
        status: 'COMPLETED'
      };

      transactions.unshift(txRecord);
      saveToStorage();

      // Reset cart & fields
      cart = [];
      document.getElementById('cash-tendered-input').value = '';
      document.getElementById('rx-reference-input').value = '';
      document.getElementById('cust-name-input').value = '';
      document.getElementById('cust-id-input').value = '';
      setDiscountType('regular');

      renderCatalog();
      renderCart();
      renderInventory();
      renderSales();

      openReceiptModal(txRecord);
      showToast(`Transaction ${txRecord.orNumber} completed!`, 'emerald');
    }

