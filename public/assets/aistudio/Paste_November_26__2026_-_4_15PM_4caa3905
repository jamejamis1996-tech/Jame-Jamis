            <td class="py-3 px-4">
              <span class="text-slate-700 font-medium">${m.category}</span>
              <span class="ml-1.5 text-[10px] font-extrabold px-1.5 py-0.5 rounded ${m.isRx ? 'bg-rose-100 text-rose-700' : 'bg-emerald-100 text-emerald-800'}">${m.isRx ? 'Rx' : 'OTC'}</span>
