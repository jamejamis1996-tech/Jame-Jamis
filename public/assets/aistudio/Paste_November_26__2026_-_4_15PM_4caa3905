              <div class="flex flex-wrap gap-1">${statusBadges.join('')}</div>
            </td>
            <td class="py-3 px-4 text-right">
              <button onclick="openEditMedicineModal('${m.id}')" class="px-3 py-1.5 bg-slate-100 hover:bg-emerald-100 hover:text-emerald-800 text-slate-700 font-bold rounded-lg transition">
