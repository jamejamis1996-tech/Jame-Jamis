            <td class="py-3 px-4 font-semibold ${days <= 30 ? 'text-rose-600' : (days <= 90 ? 'text-amber-700' : 'text-slate-700')}">${m.expiry}</td>
            <td class="py-3 px-4 font-extrabold ${m.stock <= m.reorderLevel ? 'text-amber-700' : 'text-slate-900'}">${m.stock} pcs</td>
