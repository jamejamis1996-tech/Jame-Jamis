    // ==================== INVENTORY & EXPIRY MANAGEMENT ====================
    function renderInventory() {
      const filter = document.getElementById('inv-filter-select').value;
      const tbody = document.getElementById('inventory-table-body');

      const sorted = [...medicines].sort((a, b) => new Date(a.expiry) - new Date(b.expiry));
      const filtered = sorted.filter(m => {
        const days = getDaysUntilExpiry(m.expiry);
        if (filter === 'expiring30') return days <= 30;
        if (filter === 'expiring90') return days <= 90;
        if (filter === 'lowstock') return m.stock <= m.reorderLevel;
        return true;
      });

      tbody.innerHTML = filtered.map(m => {
        const days = getDaysUntilExpiry(m.expiry);
        let statusBadges = [];

        if (days <= 0) {
          statusBadges.push(`<span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-rose-600 text-white">EXPIRED</span>`);
        } else if (days <= 30) {
          statusBadges.push(`<span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-rose-100 text-rose-700">Exp in ${days}d</span>`);
        } else if (days <= 90) {
          statusBadges.push(`<span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 text-amber-800">Exp in ${days}d</span>`);
        } else {
          statusBadges.push(`<span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800">Good (${days}d)</span>`);
        }

        if (m.stock <= m.reorderLevel) {
          statusBadges.push(`<span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 text-amber-800">Low Stock</span>`);
        }

        return `
          <tr class="hover:bg-slate-50 transition">
