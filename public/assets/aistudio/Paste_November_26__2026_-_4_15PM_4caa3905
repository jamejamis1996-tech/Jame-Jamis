      { id: 'MED-008', sku: '4800011008', brand: 'Solmux', generic: 'Carbocisteine', dosage: '500mg Capsule', category: 'OTC', isRx: false, price: 13.75, blisterSize: 10, boxSize: 100, stock: 190, reorderLevel: 60, batch: 'BTH-26S08', expiry: getRelativeDate(260) },
      { id: 'MED-009', sku: '4800011009', brand: 'Glucophage', generic: 'Metformin Hydrochloride', dosage: '500mg Tablet', category: 'Maintenance', isRx: true, price: 8.25, blisterSize: 10, boxSize: 100, stock: 340, reorderLevel: 100, batch: 'BTH-25M12', expiry: getRelativeDate(68) }, // Warning Expiry < 90 days
      { id: 'MED-010', sku: '4800011010', brand: 'Norvasc', generic: 'Amlodipine Besilate', dosage: '5mg Tablet', category: 'Maintenance', isRx: true, price: 16.50, blisterSize: 10, boxSize: 100, stock: 210, reorderLevel: 80, batch: 'BTH-26A19', expiry: getRelativeDate(400) },
      { id: 'MED-011', sku: '4800011011', brand: 'Dolfenal', generic: 'Mefenamic Acid', dosage: '500mg Tablet', category: 'Analgesics', isRx: true, price: 24.00, blisterSize: 10, boxSize: 100, stock: 120, reorderLevel: 40, batch: 'BTH-26D05', expiry: getRelativeDate(330) },
      { id: 'MED-012', sku: '4800011012', brand: 'Zithromax', generic: 'Azithromycin', dosage: '500mg Tablet', category: 'Antibiotics', isRx: true, price: 89.00, blisterSize: 3, boxSize: 30, stock: 45, reorderLevel: 20, batch: 'BTH-26Z01', expiry: getRelativeDate(290) },
      { id: 'MED-013', sku: '4800011013', brand: 'ImmunPro', generic: 'Sodium Ascorbate + Zinc', dosage: '500mg/10mg Tablet', category: 'Vitamins', isRx: false, price: 11.25, blisterSize: 10, boxSize: 100, stock: 410, reorderLevel: 100, batch: 'BTH-26I07', expiry: getRelativeDate(480) },
      { id: 'MED-014', sku: '4800011014', brand: 'Advil', generic: 'Ibuprofen', dosage: '200mg Softgel', category: 'Analgesics', isRx: false, price: 10.50, blisterSize: 10, boxSize: 100, stock: 25, reorderLevel: 50, batch: 'BTH-26AD2', expiry: getRelativeDate(210) }, // Low Stock
      { id: 'MED-015', sku: '4800011015', brand: 'Augmentin', generic: 'Co-Amoxiclav', dosage: '625mg Tablet', category: 'Antibiotics', isRx: true, price: 62.00, blisterSize: 7, boxSize: 14, stock: 84, reorderLevel: 30, batch: 'BTH-25AU8', expiry: getRelativeDate(55) }, // Warning Expiry < 90 days
      { id: 'MED-016', sku: '4800011016', brand: 'Diatabs', generic: 'Loperamide', dosage: '2mg Capsule', category: 'OTC', isRx: false, price: 9.00, blisterSize: 10, boxSize: 100, stock: 270, reorderLevel: 60, batch: 'BTH-26DT4', expiry: getRelativeDate(390) }
    ];

    // ==================== APPLICATION STATE ====================
    const PHARMACIST_ON_DUTY = 'ELSIE FE C. BUSLON, RPh';
    let medicines = [];
    let transactions = [];
    let cart = []; // { medId, unitType: 'piece'|'blister'|'box', qty: number }
    let activeCategory = 'All';
    let discountType = 'regular'; // 'regular' | 'senior' | 'pwd'
    let paymentMethod = 'Cash';
    let selectedUnitByMed = {}; // { medId: 'piece'|'blister'|'box' }
    let pendingVoidTxId = null;

    // ==================== INITIALIZATION & STORAGE ====================
    function initApp() {
      const savedMeds = localStorage.getItem('jdm_pharmacy_meds_v1');
      const savedTx = localStorage.getItem('jdm_pharmacy_tx_v1');

      medicines = savedMeds ? JSON.parse(savedMeds) : JSON.parse(JSON.stringify(INITIAL_MEDICINES));
      transactions = savedTx ? JSON.parse(savedTx) : [];

      updateClock();
      setInterval(updateClock, 1000);

      renderCatalog();
      renderCart();
      renderInventory();
      renderSales();
      updateAlertBadge();
    }

    function saveToStorage() {
      localStorage.setItem('jdm_pharmacy_meds_v1', JSON.stringify(medicines));
      localStorage.setItem('jdm_pharmacy_tx_v1', JSON.stringify(transactions));
      updateAlertBadge();
    }

    function resetDemoData() {
      medicines = JSON.parse(JSON.stringify(INITIAL_MEDICINES));
      transactions = [];
      cart = [];
      saveToStorage();
      renderCatalog();
      renderCart();
      renderInventory();
      renderSales();
      showToast('Demo data has been reset to defaults.', 'emerald');
    }

    function formatPHP(amount) {
      return '₱' + Number(amount || 0).toLocaleString('en-PH', {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
      });
    }

    function getDaysUntilExpiry(expiryStr) {
      const today = new Date();
      today.setHours(0, 0, 0, 0);
      const exp = new Date(expiryStr);
      exp.setHours(0, 0, 0, 0);
      return Math.ceil((exp - today) / (1000 * 60 * 60 * 24));
    }

    function updateAlertBadge() {
      const alertCount = medicines.filter(m => getDaysUntilExpiry(m.expiry) <= 90 || m.stock <= m.reorderLevel).length;
      const badge = document.getElementById('alert-badge');
      if (badge) badge.textContent = alertCount;
    }

    function updateClock() {
      const now = new Date();
      const opts = { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit', second: '2-digit' };
      document.getElementById('live-clock').textContent = now.toLocaleString('en-PH', opts);
    }

    // ==================== NAVIGATION TABS ====================
    function switchTab(tabName) {
      ['pos', 'inventory', 'sales'].forEach(t => {
        document.getElementById(`view-${t}`).classList.toggle('hidden', t !== tabName);
        const btn = document.getElementById(`tab-${t}`);
        if (t === tabName) {
          btn.classList.add('bg-white', 'text-emerald-900', 'shadow-sm');
          btn.classList.remove('text-emerald-100', 'hover:bg-emerald-800');
        } else {
          btn.classList.remove('bg-white', 'text-emerald-900', 'shadow-sm');
          btn.classList.add('text-emerald-100', 'hover:bg-emerald-800');
        }
      });

      if (tabName === 'inventory') renderInventory();
      if (tabName === 'sales') renderSales();
    }

    // ==================== POS CATALOG & SEARCH ====================
    function setCategory(category) {
      activeCategory = category;
      document.querySelectorAll('.cat-pill').forEach(btn => {
        if (btn.dataset.cat === category) {
          btn.classList.add('bg-emerald-700', 'text-white');
          btn.classList.remove('bg-slate-100', 'text-slate-700', 'hover:bg-slate-200');
        } else {
          btn.classList.remove('bg-emerald-700', 'text-white');
          btn.classList.add('bg-slate-100', 'text-slate-700', 'hover:bg-slate-200');
        }
      });
      renderCatalog();
    }

    function clearSearch() {
      const input = document.getElementById('pos-search');
      input.value = '';
      renderCatalog();
      input.focus();
    }

    function changeCardUnit(medId, unit) {
      selectedUnitByMed[medId] = unit;
      renderCatalog();
    }

    function renderCatalog() {
      const query = document.getElementById('pos-search').value.trim().toLowerCase();
      document.getElementById('clear-search-btn').classList.toggle('hidden', query.length === 0);

      // Sort by FEFO (First-Expired, First-Out)
      const sortedMeds = [...medicines].sort((a, b) => new Date(a.expiry) - new Date(b.expiry));

      const filtered = sortedMeds.filter(m => {
        const matchesCat = activeCategory === 'All' || m.category === activeCategory;
        const matchesQuery = !query ||
          m.brand.toLowerCase().includes(query) ||
          m.generic.toLowerCase().includes(query) ||
          m.sku.toLowerCase().includes(query) ||
          m.category.toLowerCase().includes(query);
        return matchesCat && matchesQuery;
      });

      const grid = document.getElementById('catalog-grid');
      if (filtered.length === 0) {
        const rawQuery = document.getElementById('pos-search').value.trim();
        grid.innerHTML = `
          <div class="col-span-full bg-white rounded-2xl border border-slate-200 p-8 text-center text-slate-500 space-y-3">
            <div>
              <p class="font-bold text-sm text-slate-700">Wala pa sa system ang "${rawQuery || 'gipangita nga tambal'}"</p>
              <p class="text-xs text-slate-400 mt-1">Pwede nimo i-add karon dayon sa JDM PHARMACY system apil ang presyo ug stock.</p>
            </div>
            <button onclick="openAddMedicineModal('${rawQuery.replace(/'/g, "\\'")}')" class="inline-flex items-center gap-1.5 px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold rounded-xl shadow-sm transition">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
              <span>+ Add "${rawQuery || 'New Medicine'}" to System</span>
            </button>
          </div>
        `;
        return;
      }

      grid.innerHTML = filtered.map(m => {
        const unit = selectedUnitByMed[m.id] || 'piece';
        const multiplier = unit === 'box' ? m.boxSize : (unit === 'blister' ? m.blisterSize : 1);
        const unitPrice = m.price * multiplier;
        const outOfStock = m.stock < multiplier;
        const isLowStock = m.stock <= m.reorderLevel;
        const daysToExp = getDaysUntilExpiry(m.expiry);

        let expiryTag = '';
        if (daysToExp <= 30) {
          expiryTag = `<span class="bg-rose-100 text-rose-700 font-bold px-2 py-0.5 rounded-md">Exp: ${daysToExp}d</span>`;
        } else if (daysToExp <= 90) {
          expiryTag = `<span class="bg-amber-100 text-amber-800 font-semibold px-2 py-0.5 rounded-md">Exp: ${daysToExp}d</span>`;
        }

        return `
          <div class="bg-white rounded-2xl border ${outOfStock ? 'border-slate-200 opacity-60' : 'border-slate-200 hover:border-emerald-400'} p-3.5 shadow-xs flex flex-col justify-between gap-3 transition">
            <div>
              <div class="flex items-start justify-between gap-2">
                <div class="min-w-0">
                  <h3 class="font-extrabold text-slate-900 text-sm truncate" title="${m.brand}">${m.brand}</h3>
                  <p class="text-xs text-slate-500 truncate" title="${m.generic}">${m.generic}</p>
                </div>
