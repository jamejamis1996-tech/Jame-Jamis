      document.getElementById('med-add-to-cart-option').classList.remove('hidden');
      document.getElementById('med-auto-cart').checked = true;
      document.getElementById('medicine-modal').classList.remove('hidden');
      setTimeout(() => document.getElementById('med-brand').focus(), 100);
    }

    function openEditMedicineModal(medId) {
      const m = medicines.find(item => item.id === medId);
      if (!m) return;

      document.getElementById('med-modal-title').textContent = `Edit / Restock: ${m.brand}`;
      document.getElementById('med-edit-id').value = m.id;
      document.getElementById('med-add-to-cart-option').classList.add('hidden');
      document.getElementById('med-brand').value = m.brand;
      document.getElementById('med-generic').value = m.generic;
      document.getElementById('med-dosage').value = m.dosage;
      document.getElementById('med-category').value = m.category;
      document.getElementById('med-rx').value = String(m.isRx);
      document.getElementById('med-batch').value = m.batch;
      document.getElementById('med-expiry').value = m.expiry;
      document.getElementById('med-price').value = m.price;
      document.getElementById('med-blister-size').value = m.blisterSize;
      document.getElementById('med-box-size').value = m.boxSize;
      document.getElementById('med-stock').value = m.stock;
      document.getElementById('med-reorder').value = m.reorderLevel;
      document.getElementById('medicine-modal').classList.remove('hidden');
    }

    function saveMedicine(event) {
      event.preventDefault();
      const editId = document.getElementById('med-edit-id').value;

      const medData = {
        brand: document.getElementById('med-brand').value.trim(),
        generic: document.getElementById('med-generic').value.trim(),
        dosage: document.getElementById('med-dosage').value.trim(),
        category: document.getElementById('med-category').value,
        isRx: document.getElementById('med-rx').value === 'true',
        batch: document.getElementById('med-batch').value.trim(),
        expiry: document.getElementById('med-expiry').value,
        price: parseFloat(document.getElementById('med-price').value) || 0,
        blisterSize: parseInt(document.getElementById('med-blister-size').value, 10) || 10,
        boxSize: parseInt(document.getElementById('med-box-size').value, 10) || 100,
        stock: parseInt(document.getElementById('med-stock').value, 10) || 0,
        reorderLevel: parseInt(document.getElementById('med-reorder').value, 10) || 50
      };

      if (editId) {
        const idx = medicines.findIndex(m => m.id === editId);
        if (idx !== -1) {
          medicines[idx] = { ...medicines[idx], ...medData };
          showToast(`${medData.brand} updated successfully!`, 'emerald');
        }
      } else {
        const newMed = {
          id: 'MED-' + String(Date.now()).slice(-4),
          sku: '48000' + String(Math.floor(10000 + Math.random() * 90000)),
          ...medData
        };
        medicines.unshift(newMed);
        showToast(`${medData.brand} added to JDM PHARMACY inventory!`, 'emerald');

        // Auto-add to cart if checked and has stock
        if (document.getElementById('med-auto-cart').checked && newMed.stock > 0) {
          selectedUnitByMed[newMed.id] = 'piece';
          addToCart(newMed.id);
        }
      }

      saveToStorage();
      closeModal('medicine-modal');
      renderCatalog();
      renderInventory();
    }

    // ==================== SALES REPORTS & VOID AUDIT ====================
    function renderSales() {
      const completed = transactions.filter(t => t.status === 'COMPLETED');
      const totalRev = completed.reduce((sum, t) => sum + t.netTotal, 0);
      const totalDisc = completed.reduce((sum, t) => sum + t.totalDiscount, 0);

      // Compute top-selling medicine
      const itemCounts = {};
      completed.forEach(tx => {
        tx.items.forEach(item => {
          itemCounts[item.brand] = (itemCounts[item.brand] || 0) + item.totalPieces;
        });
      });

      let topName = '—';
      let topQty = 0;
      Object.entries(itemCounts).forEach(([brand, qty]) => {
        if (qty > topQty) {
          topName = brand;
          topQty = qty;
        }
      });

      document.getElementById('kpi-revenue').textContent = formatPHP(totalRev);
      document.getElementById('kpi-transactions').textContent = completed.length;
      document.getElementById('kpi-discounts').textContent = formatPHP(totalDisc);
      document.getElementById('kpi-top-item').textContent = topName;
      document.getElementById('kpi-top-item-sub').textContent = `${topQty} pcs dispensed`;

      const tbody = document.getElementById('sales-table-body');
      if (transactions.length === 0) {
        tbody.innerHTML = `<tr><td colspan="8" class="py-8 text-center text-slate-400 font-semibold">No transactions recorded yet. Complete a sale in POS Checkout!</td></tr>`;
        return;
      }

      tbody.innerHTML = transactions.map(tx => {
        const isVoid = tx.status === 'VOIDED';
        const itemSummary = tx.items.map(i => `${i.brand} (${i.qty} ${i.unitType})`).join(', ');
        return `
          <tr class="${isVoid ? 'bg-rose-50/50 text-slate-400' : 'hover:bg-slate-50'}">
            <td class="py-3 px-4 font-mono font-bold ${isVoid ? 'line-through' : 'text-slate-900'}">${tx.orNumber}</td>
            <td class="py-3 px-4">${new Date(tx.timestamp).toLocaleString('en-PH')}</td>
            <td class="py-3 px-4 font-medium">${tx.cashier}</td>
            <td class="py-3 px-4">
              <div class="font-semibold">${tx.customerName}</div>
              <span class="text-[10px] uppercase font-bold px-1.5 py-0.5 rounded bg-slate-100 text-slate-600">${tx.discountType}</span>
            </td>
            <td class="py-3 px-4 max-w-[220px] truncate" title="${itemSummary}">${itemSummary}</td>
            <td class="py-3 px-4 font-extrabold ${isVoid ? 'line-through' : 'text-emerald-700'}">${formatPHP(tx.netTotal)}</td>
            <td class="py-3 px-4">
              <span class="px-2 py-0.5 rounded-full text-[10px] font-bold ${isVoid ? 'bg-rose-100 text-rose-700' : 'bg-emerald-100 text-emerald-800'}">
                ${tx.status}
              </span>
            </td>
            <td class="py-3 px-4 text-right space-x-1.5 whitespace-nowrap">
              <button onclick="reprintReceipt('${tx.orNumber}')" class="px-2.5 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold rounded-lg">Reprint</button>
              ${!isVoid ? `<button onclick="promptVoidTransaction('${tx.orNumber}')" class="px-2.5 py-1 bg-rose-50 hover:bg-rose-100 text-rose-700 font-bold rounded-lg">Void</button>` : ''}
            </td>
          </tr>
        `;
      }).join('');
    }

    function reprintReceipt(orNumber) {
      const tx = transactions.find(t => t.orNumber === orNumber);
      if (tx) openReceiptModal(tx);
    }

    function promptVoidTransaction(orNumber) {
      pendingVoidTxId = orNumber;
      document.getElementById('void-or-label').textContent = orNumber;
      document.getElementById('void-pin-input').value = '';
      document.getElementById('void-modal').classList.remove('hidden');
      setTimeout(() => document.getElementById('void-pin-input').focus(), 100);
    }

    function confirmVoidTransaction() {
      const pin = document.getElementById('void-pin-input').value;
      if (pin !== '1234') {
        showToast('Invalid Pharmacist PIN! Hint: 1234', 'rose');
        return;
      }

      const tx = transactions.find(t => t.orNumber === pendingVoidTxId);
      if (tx && tx.status === 'COMPLETED') {
        tx.status = 'VOIDED';
        // Restore stock
        tx.items.forEach(item => {
          const med = medicines.find(m => m.id === item.medId);
          if (med) med.stock += item.totalPieces;
        });

        saveToStorage();
        renderCatalog();
        renderInventory();
        renderSales();
        showToast(`Transaction ${tx.orNumber} voided and stock restored.`, 'amber');
      }

      closeModal('void-modal');
      pendingVoidTxId = null;
    }

    // ==================== TOAST HELPER ====================
    function showToast(message, color = 'emerald') {
      const container = document.getElementById('toast-container');
      const toast = document.createElement('div');
      const bgMap = {
        emerald: 'bg-emerald-800 text-white border-emerald-600',
        amber: 'bg-amber-600 text-white border-amber-400',
        rose: 'bg-rose-700 text-white border-rose-500'
      };
      toast.className = `px-4 py-2.5 rounded-xl shadow-lg border text-xs font-bold transition-all duration-300 ${bgMap[color] || bgMap.emerald}`;
      toast.textContent = message;
      container.appendChild(toast);

      setTimeout(() => {
        toast.style.opacity = '0';
        setTimeout(() => toast.remove(), 300);
      }, 3000);
    }

    // Boot App
    window.addEventListener('DOMContentLoaded', initApp);
  </script>
</body>
